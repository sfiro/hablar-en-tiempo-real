# Clave de la API de OpenAI (necesita acceso a la Realtime API).
#
# SIN COMILLAS a propósito, a diferencia del resto del proyecto: voice_chat.py
# y voice_rest.py parsean este fichero a mano (no usan python-dotenv) con
# line.split('=', 1)[1].strip() — eso NO quita comillas, así que
# OPENAI_API_KEY="sk-..." dejaría las comillas pegadas a la clave y rompería
# la autenticación con OpenAI.
OPENAI_API_KEY=sk-...
